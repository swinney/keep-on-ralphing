# Worked example: consumer Containerfile for "Acme Widgets" (Python library).
# The whole file: FROM the ralph base + this project's toolchain.

FROM ralph-base:v1

# --- project toolchain: the exact tools scripts/gate.sh runs ----------------
# scripts/gate.sh is the SINGLE source of the gate command; do not restate it here.
RUN pip install --no-cache-dir \
        ruff==0.15.15 \
        mypy==2.1.0 \
        pytest \
        pytest-cov
# --- end project-specific block ---------------------------------------------
