# ralph.conf — the one place you set project-specific values for the Ralph
# harness. Copy this file to `ralph.conf` (next to where you run the scripts,
# usually your repo root) and edit. Every value here can also be overridden by
# an environment variable of the same name; precedence is:
#
#     environment  >  ralph.conf  >  the script's built-in default
#
# This is plain shell (sourced by ralph.sh, and read by the /ralph-status skill):
# KEY="value", no spaces around `=`, `#` starts a comment.

# --- where the loop operates -------------------------------------------------

# Project directory the loop runs in. Inside a container this is the bind-mount
# target (e.g. /workspace); on the host it is usually your repo root.
# Default: the current working directory.
RALPH_WORKSPACE="/workspace"

# Task-list file the loop reads the "first unchecked task" from, relative to the
# workspace. Default: tasks.md
RALPH_TASKS="tasks.md"

# Runtime state directory (heartbeat, per-turn logs, status feed, turn counter),
# relative to the workspace. MUST be gitignored. Default: .ralph
RALPH_STATE_DIR=".ralph"

# (Meta) path to THIS config file. Set as an environment variable only, to point
# the scripts at a config that is not ./ralph.conf. Default: ./ralph.conf
# RALPH_CONF="/path/to/ralph.conf"

# --- agent / turn behaviour --------------------------------------------------

# Model id passed to `claude --model`. Leave empty to use the account default.
RALPH_MODEL=""

# Per-turn wall-clock cap in seconds. A turn exceeding it is killed and retried
# (counts as a no-commit turn). Default: 1200 (20 min)
RALPH_TURN_TIMEOUT="1200"

# Consecutive no-commit turns before the loop halts for human review. Default: 2
RALPH_MAX_STALLS="2"

# Fallback wait, in seconds, when a usage-limit message has no parseable reset
# time (until_reset.py could not read a clock time). Default: 900 (15 min)
RALPH_LIMIT_POLL="900"

# Inter-turn sleep in loop mode, in seconds. Default: 30
RALPH_POLL_INTERVAL="30"

# --- aggregate log (for an external log aggregator) --------------------------

# Write a single append-only $RALPH_STATE_DIR/log/live.log that interleaves the
# runner's narration with each turn's agent output, every line turn-prefixed and
# ISO-timestamped — one stable tail target for an aggregator (Vector, Logstash,
# …) or a bare `tail -f`. The per-turn turn-<n>.txt files and status.jsonl are
# unaffected. 1 = on, 0 = reproduce the pre-feature behaviour exactly. The kit
# ships NO aggregator; see docs/recipes/vector-console.md for a zero-backend
# realtime view. Default: 1 (on)
RALPH_LIVE_LOG="1"

# --- outer-loop review gate (ON by default — this loop is GitHub-dependent) --
#
# After a turn commits, the loop (the RUNNER, never the agent) pushes the branch,
# ensures a PR, requests an independent review, and reads the verdict: PASS = zero
# findings AND green CI. Findings are written to review-findings.md and become the
# agent's top-priority work next turn; persistent findings halt the loop after
# RALPH_REVIEW_MAX_ROUNDS for a human. The container agent stays GitHub-blind, so
# this works with any coding agent.
#
# Because it is ON by default, loop mode REQUIRES a git remote, an authenticated
# `gh`, and a NON-base feature branch, and REFUSES to start without them
# (/ralph-init ensures these up front). Set RALPH_REVIEW_GATE=0 only if you
# explicitly want the offline inner loop with no review.

# 1 enables the push -> PR -> review -> verdict cycle; 0 = offline inner loop. Default: 1 (ON)
RALPH_REVIEW_GATE="1"

# 1 to merge a PASSED PR into the base branch; 0 leaves it ready for a human to
# merge. Independent of RALPH_REVIEW_GATE. Default: 0 (off)
RALPH_AUTO_MERGE="0"

# Consecutive review rounds that still produce findings on one PR before the loop
# halts to STATUS.md for human review. Default: 3
RALPH_REVIEW_MAX_ROUNDS="3"

# PR base branch. Empty = origin's default branch (e.g. main). Default: auto
RALPH_BASE_BRANCH=""

# Reviewer command, run as `<cmd> <pr-number>`, printing findings one per line
# (empty output = clean). Empty = the built-in GitHub Copilot reviewer. This is
# the substitution seam for a non-Copilot reviewer. Default: Copilot
RALPH_REVIEWER=""

# --- outbound notification (opt-in — ping a human when the loop needs one) ----
#
# When developing async (kick off a loop and walk away), the loop can summon you
# back the moment a human is needed. The RUNNER (never the agent) invokes this
# command as `<cmd> <event> <one-line-reason>` at every needs-human halt — events
# are: review-exhausted, stall, stop, and blocked (a new docs/questions.md entry).
# Notification is NON-FATAL: a notifier that errors, hangs, or is slow is killed
# and ignored, never changing the loop's exit code or flow. Empty = off (no
# notification side effects). See docs/recipes/slack-notify.md for a Slack webhook
# recipe (and a zero-dep `gh pr comment` alternative).
#
# SECURITY: the runner runs IN the container and invokes the notifier there, so any
# secret the command needs (e.g. SLACK_WEBHOOK_URL) lives in the container env —
# the SAME plane as the forwarded GH_TOKEN. "Agent-blind" is behavioral (the runner
# owns all git/gh/network work), not env isolation; treat a webhook as GH_TOKEN-grade.
#
# A single command/script path, run as `<cmd> <event> <reason>`. Empty = off. Default: off
RALPH_NOTIFY_CMD=""

# Seconds the notifier may run before it is killed (kept short — a halt is not
# latency-sensitive, and a hung notifier must not delay the halt). Default: 30
RALPH_NOTIFY_TIMEOUT="30"

# The file the agent writes a blocked question to (a decision the specs don't
# cover). A NEW entry mid-run stops the loop immediately with a `blocked`
# notification, instead of burning RALPH_MAX_STALLS no-commit turns first. A
# pre-existing list does NOT stop a fresh loop. Default: docs/questions.md
RALPH_QUESTIONS="docs/questions.md"

# --- container probing (status digest + Makefile) ---------------------------

# Name of the loop container the status digest probes for "is it running?", and
# the image/container name the Makefile builds and runs. Default: ralph-loop
RALPH_CONTAINER="ralph-loop"

# Container runtime CLI. Default: podman. Docker can work, but the Makefile's
# RUN_FLAGS use the Podman-specific `--userns=keep-id`; Docker users must adjust
# those flags (drop it / use `--user`). The status digest is runtime-agnostic.
RALPH_RUNTIME="podman"
